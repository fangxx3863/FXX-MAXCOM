{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maxcom-contracts:transport.schema.json",
  "title": "传输/连接配置",
  "description": "传输层配置（V2 §1.1 + §4.4）。transport.toml。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "enum": ["serial", "tcp_client", "tcp_server", "udp_client", "udp_server", "ssh", "telnet", "rtt", "winusb", "hid"] },
    "port": { "type": "string", "description": "串口号，如 COM3" },
    "alias": { "type": "string", "description": "自定义别名" },
    "baudrate": { "type": "integer", "minimum": 300 },
    "data_bits": { "enum": [5, 6, 7, 8] },
    "stop_bits": { "enum": [1, 1.5, 2] },
    "parity": { "enum": ["none", "even", "odd", "mark", "space"] },
    "flow_control": { "enum": ["none", "software", "hardware"] },
    "host": { "type": "string", "description": "TCP/UDP 主机" },
    "port_no": { "type": "integer", "description": "TCP/UDP 端口" },
    "username": { "type": "string", "description": "SSH 用户名" },
    "password": { "type": "string", "description": "SSH 密码（可选，为空时尝试 SSH Agent/常用私钥）" },
    "probe_selector": { "type": "string", "description": "RTT 探针选择器（\"VID:PID\" 或 \"VID:PID:serial\"，空=第一个探针）" },
    "chip": { "type": "string", "description": "RTT 目标芯片，如 nrf52840 / rp2040 / stm32f103ct6" },
    "up_channel": { "type": "integer", "minimum": 0, "default": 0, "description": "RTT up 通道（目标→主机，打印输出）" },
    "down_channel": { "type": "integer", "minimum": 0, "default": 0, "description": "RTT down 通道（主机→目标，发送）" },
    "rtt_address": { "type": "integer", "description": "RTT 控制块起始地址（可选；提供后跳过扫描）" },
    "vid": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "USB/HID 设备 Vendor ID（十进制数；前端以 hex 展示）" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "USB/HID 设备 Product ID（十进制数；前端以 hex 展示）" },
    "interface": { "type": "integer", "minimum": 0, "maximum": 255, "description": "winusb 接口号；省略=自动挑选第一个含 bulk/interrupt 数据端点的接口" },
    "out_ep": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0, "description": "winusb OUT 端点地址（如 0x01）；0=自动（优先 bulk、回退 interrupt）" },
    "in_ep": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0, "description": "winusb IN 端点地址（如 0x81）；0=自动（优先 bulk、回退 interrupt）" },
    "serial": { "type": "string", "description": "HID 序列号（同 VID:PID 多设备时精确匹配；空=取第一个匹配设备）" },
    "report_id": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0, "description": "HID 写时前置的 Report ID（单报告设备为 0）" },
    "strip_report_id": { "type": "boolean", "default": true, "description": "HID 读时是否剥掉首字节 Report ID（单报告设备首字节恒为 0x00）" },
    "auto_reconnect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "max_retries": { "type": "integer", "default": 10 },
        "interval_ms": { "type": "integer", "default": 1000 }
      }
    }
  },
  "required": ["type"]
}
