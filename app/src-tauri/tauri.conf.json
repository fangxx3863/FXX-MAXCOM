{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAXCOM",
  "version": "0.2.0",
  "identifier": "fun.fangxx.maxcom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAXCOM",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "一站式串口/网络调试与数据可视化",
    "longDescription": "MAXCOM：串口 / TCP / UDP / SSH / Telnet 调试与数据可视化平台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}