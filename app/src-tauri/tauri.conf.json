{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAXCOM",
  "version": "0.2.0",
  "identifier": "fun.fangxx.maxcom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAXCOM — 一站式串口/网络调试平台",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"]
  }
}
